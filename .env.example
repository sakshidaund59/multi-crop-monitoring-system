# General Application Configuration
PROJECT_NAME="Multi-Crop Monitoring System"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# PostgreSQL + PostGIS Database Configuration
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=crop_user
POSTGRES_PASSWORD=crop_password_dev
POSTGRES_DB=crop_monitoring_db
DATABASE_URL=postgresql+asyncpg://crop_user:crop_password_dev@db:5432/crop_monitoring_db
SYNC_DATABASE_URL=postgresql+psycopg2://crop_user:crop_password_dev@db:5432/crop_monitoring_db

# Redis Configuration (For background tasks & caching)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
